# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server-only: it bypasses RLS and is used solely by the
# admin account actions. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Instagram (optional) — the public homepage falls back gracefully without it.
# See docs/INSTAGRAM.md for how to obtain a long-lived token.
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Academy details shown on the public homepage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ACADEMY_NAME=UBE Academy
NEXT_PUBLIC_ACADEMY_TAGLINE=Volleyball, played properly.
NEXT_PUBLIC_ACADEMY_EMAIL=hello@ubeacademy.com
NEXT_PUBLIC_ACADEMY_LOCATION=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ube.academy/
NEXT_PUBLIC_INSTAGRAM_HANDLE=ube.academy

# ---------------------------------------------------------------------------
# Formatting. CURRENCY is an ISO 4217 code; TIME_ZONE an IANA zone.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_TIME_ZONE=UTC
